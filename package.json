{
  "name": "rempatia-ged-landing",
  "version": "0.1.0",
  "private": true,
  "description": "Remparia GED landing page",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --parallel --filter @rempatia/api --filter rempatia-ged-landing run dev:web",
    "dev:web": "next dev -H 127.0.0.1 -p 5173",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 5173",
    "test": "pnpm --filter @rempatia/api test && node --experimental-strip-types --test apps/web/tests/*.test.mjs",
    "db:migrate": "pnpm --filter @rempatia/db migrate"
  },
  "dependencies": {
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
